{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.mcpuniversalstudio.app",
  "productName": "MCP Universal Studio",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "bridge/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "bridge",
      "to": "bridge",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MCP Universal Studio"
  },
  "portable": {
    "artifactName": "MCP_Universal_Studio_Portable_${version}.exe"
  }
}
